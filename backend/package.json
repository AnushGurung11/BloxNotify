{
  "name": "blox-notify-backend",
  "version": "1.0.0",
  "description": "Polls the Blox Fruits wiki stock page and pushes FCM notifications on stock changes",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "verify:stock": "node scripts/verify-stock.js",
    "verify:history": "node scripts/verify-history.js",
    "verify:values": "node scripts/verify-values.js"
  },
  "keywords": [
    "blox-fruits",
    "fandom",
    "fcm",
    "push-notifications"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
