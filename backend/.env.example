# Blox Notify backend environment variables

# Port the Express server listens on
PORT=3000

# How often to poll the FruityBlox stock feed (milliseconds). Default: 90000 (90 seconds)
POLL_INTERVAL_MS=90000

# FCM topic to publish stock updates to. The app subscribes to this topic.
FCM_TOPIC=stock_updates

# Firebase service account JSON (one line, quoted). Required for push
# notifications; when unset the backend still tracks stock and serves /stock
# but skips sending notifications.
# FIREBASE_SERVICE_ACCOUNT=

# Alternative to the above: path to the service account JSON file. Either one
# is enough; the file path wins if both are set.
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/your-service-account.json

# Path to the last-known-stock state file (optional, has a sensible default)
# STOCK_FILE=./data/last-known-stock.json

# Overrides for the wiki history source (only needed for tests / mirrors)
# WIKI_API_URL=https://blox-fruits.fandom.com/api.php
# WIKI_PAGE=History_of_Stock
